# Copy to .env.local and fill in. In development the app runs without any of
# these set: the contact form and the Cal.com webhook accept submissions and
# log them server-side instead of emailing. In production RESEND_API_KEY,
# CONTACT_TO_EMAIL and CONTACT_FROM_EMAIL are required (the routes return 500
# without them), as is CAL_WEBHOOK_SECRET.

# Resend API key. https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact-form notifications and Cal.com booking alerts.
CONTACT_TO_EMAIL=

# From address for those emails. Its domain must be verified in Resend.
CONTACT_FROM_EMAIL=

# Shared secret set on the Cal.com webhook (Settings, Developer, Webhooks).
# Used to verify the x-cal-signature-256 header. If unset, the webhook skips
# verification in development and rejects every request in production.
CAL_WEBHOOK_SECRET=
