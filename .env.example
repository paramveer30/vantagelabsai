# Copy to .env.local and fill in. Without RESEND_API_KEY the contact form
# still succeeds, but submissions are only logged server-side, not emailed.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact-form notifications.
CONTACT_TO_EMAIL=

# From address for the notification. Its domain must be verified in Resend.
CONTACT_FROM_EMAIL=
