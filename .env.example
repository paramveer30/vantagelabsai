# Copy to .env.local and fill in. Without RESEND_API_KEY the contact form and
# the Cal.com booking webhook still succeed, but nothing is emailed — the
# submission / booking is only logged server-side.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact-form notifications and Cal.com booking alerts.
CONTACT_TO_EMAIL=

# From address for those emails. Its domain must be verified in Resend.
CONTACT_FROM_EMAIL=

# Shared secret set on the Cal.com webhook (Settings → Developer → Webhooks).
# Used to verify the x-cal-signature-256 header. If unset, the webhook skips
# signature verification (dev only).
CAL_WEBHOOK_SECRET=
